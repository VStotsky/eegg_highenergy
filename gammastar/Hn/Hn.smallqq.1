  (3 - T)*G[{(1 - T)^(-1)}, 1] + ((2*I)*Pi*(2*(1 - T) - (1 - T)^2 + T)*
    G[{(1 - T)^(-1)}, 1])/(1 - T) - ((1 - T)*(2 + T)*G[{T^(-1)}, 1])/
   (-1 + T) - ((2*I)*Pi*(-1 - T + T^2)*G[{T^(-1)}, 1])/T - 
  (2*(2*(1 - T) - (1 - T)^2 + T)*G[{0, (1 - T)^(-1)}, 1])/(1 - T) + 
