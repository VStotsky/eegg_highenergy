  (4*(-1 - T + T^2)*G[{T^(-1), T^(-1)}, 1])/T - 2*Log[mm], 
 3*(-1 + 2*T) - (I*Pi*(-1 + 2*T)*(4 - 4*(1 - T) - 4*T + (1 - T)*T))/
   ((-1 + T)*T) + (3 - T)*G[{(1 - T)^(-1)}, 1] + 
  ((2*I)*Pi*((1 - T)^2 + T)*G[{(1 - T)^(-1)}, 1])/(1 - T) + 
