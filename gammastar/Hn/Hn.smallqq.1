 2 - ((2*I)*Pi*(2*(1 - T) + T))/(-1 + T) + ((4*I)*Pi*G[{T^(-1)}, 1])/T - 
  (2*(2*(1 - T) + T)*G[{T^(-1)}, 1])/(-1 + T) - (4*G[{0, T^(-1)}, 1])/T - 
  (4*G[{T^(-1), 1}, 1])/T + (8*G[{T^(-1), T^(-1)}, 1])/T + 
  (2*(-2 + 2*(1 - T)^2 + 2*T + 3*(1 - T)*T + T^2)*Log[qq])/(-1 + T), 
