f313c617b116"],

Cell[BoxData[
 RowBox[{"(*", " ", 
  RowBox[{
   RowBox[{
   "To", " ", "perform", " ", "this", " ", "comparison", " ", "you", " ", 
    "will", " ", "need", " ", "LiteRed2"}], ",", " ", 
   RowBox[{
   "as", " ", "well", " ", "as", " ", "packages", " ", "that", " ", "allow", " ",
     "you", " ", "to", " ", "calculate", " ", "traces", " ", "of", " ", 
    "gamma", " ", "matrices", " ", "and", " ", "the", " ", "numerical", " ", 
    "count", " ", "of", " ", 
    RowBox[{"Goncharov", "'"}], "s", " ", "polylogarythms", " ", 
    RowBox[{"(", 
     RowBox[{"we", " ", "use", " ", "GMatrices", " ", "and", " ", "REPLica"}],
      ")"}]}]}], "*)"}]], "Input",
 CellChangeTimes->{{4.002954908505548*^9, 4.002954947743342*^9}, {
  4.002955021001367*^9, 
  4.0029550874631*^9}},ExpressionUUID->"01cbd937-2642-4e2b-a827-15f7cc12895c"],

Cell[CellGroupData[{

Cell["Load packages", "Subsubsection",
