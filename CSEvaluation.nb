Cell[CellGroupData[{

Cell["Defining set of basis tensors", "Subsubsection",
 CellChangeTimes->{{4.0029565663613157`*^9, 4.00295658680155*^9}, {
  4.003005352099435*^9, 
  4.003005356809724*^9}},ExpressionUUID->"bdc17ab1-d38f-4ed4-840a-\
9ab7933a4e63"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Pm", "=", 
   RowBox[{"p1", "-", "p2"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Km", "=", 
   RowBox[{"k1", "-", "k2"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ks", "=", 
   RowBox[{"{", 
    RowBox[{"k1", ",", "k2"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   SubscriptBox[
    RowBox[{"(", 
     SubscriptBox["g", 
      RowBox[{"\[Mu]", ",", "\[Nu]"}]], ")"}], 
    RowBox[{"\[Null]", "\[Perpendicular]", "\[Null]"}]], ":=", 
   RowBox[{"(", 
    RowBox[{
     SubscriptBox["g", 
      RowBox[{"\[Mu]", ",", "\[Nu]"}]], "-", 
     FractionBox[
      RowBox[{
       SubscriptBox["k1", "\[Mu]"], " ", 
       SubscriptBox["k2", "\[Nu]"]}], 
      RowBox[{"k1", "\[CenterDot]", "k2"}]]}], ")"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   SubscriptBox[
    RowBox[{"(", 
     RowBox[{"SubIndex", "[", 
      RowBox[{
       RowBox[{"p", ":", 
        RowBox[{"Alternatives", "@@", "ks"}]}], ",", "ind_"}], "]"}], ")"}], 
    RowBox[{"\[Null]", "\[Perpendicular]", "\[Null]"}]], ":=", 
   RowBox[{
    SubscriptBox["p", "ind"], "-", 
    FractionBox[
     RowBox[{
      RowBox[{"SubIndex", "[", 
       RowBox[{"Pm", ",", "ind"}], "]"}], 
      RowBox[{"k1", "\[CenterDot]", "k2"}]}], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Complement", "[", 
         RowBox[{"ks", ",", 
          RowBox[{"{", "p", "}"}]}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}], ")"}], "\[CenterDot]", "Pm"}]]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   SubscriptBox[
    RowBox[{"(", 
     RowBox[{"SubIndex", "[", 
      RowBox[{"GMatrix", ",", "ind_"}], "]"}], ")"}], 
    RowBox[{"\[Null]", "\[Perpendicular]", "\[Null]"}]], ":=", 
   RowBox[{
    RowBox[{"SubIndex", "[", 
     RowBox[{"GMatrix", ",", "ind"}], "]"}], "-", 
    FractionBox[
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"ind", "===", "\[Nu]"}], ",", 
       RowBox[{
        RowBox[{"GHat", "[", "k1", "]"}], 
        RowBox[{"SubIndex", "[", 
         RowBox[{"k2", ",", "ind"}], "]"}]}], ",", 
       RowBox[{
        RowBox[{"GHat", "[", "k2", "]"}], 
        RowBox[{"SubIndex", "[", 
         RowBox[{"k1", ",", "ind"}], "]"}]}]}], "]"}], 
     RowBox[{"k1", "\[CenterDot]", "k2"}]]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"tensors", "=", 
   RowBox[{
    RowBox[{"Join", "[", 
     RowBox[{
      RowBox[{"GIdentity", "*", 
       RowBox[{"{", 
        RowBox[{
         SubscriptBox[
          RowBox[{"(", 
           SubscriptBox["g", 
            RowBox[{"\[Mu]", ",", "\[Nu]"}]], ")"}], 
          RowBox[{"\[Null]", "\[Perpendicular]", "\[Null]"}]], ",", 
         RowBox[{
          SubscriptBox[
           RowBox[{"(", 
            SubscriptBox["k2", "\[Nu]"], ")"}], 
           RowBox[{"\[Null]", "\[Perpendicular]", "\[Null]"}]], 
          SubscriptBox[
           RowBox[{"(", 
            SubscriptBox["k1", "\[Mu]"], ")"}], 
           RowBox[{"\[Null]", "\[Perpendicular]", "\[Null]"}]]}]}], "}"}]}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            SubscriptBox[
             RowBox[{"(", 
              SubscriptBox["\[Gamma]", "\[Nu]"], ")"}], 
             RowBox[{"\[Null]", "\[Perpendicular]", "\[Null]"}]], 
            SubscriptBox[
             RowBox[{"(", 
              SubscriptBox["k1", "\[Mu]"], ")"}], 
             RowBox[{"\[Null]", "\[Perpendicular]", "\[Null]"}]]}], "-", 
           RowBox[{
            SubscriptBox[
             RowBox[{"(", 
              SubscriptBox["\[Gamma]", "\[Mu]"], ")"}], 
             RowBox[{"\[Null]", "\[Perpendicular]", "\[Null]"}]], 
            SubscriptBox[
             RowBox[{"(", 
              SubscriptBox["k2", "\[Nu]"], ")"}], 
             RowBox[{"\[Null]", "\[Perpendicular]", "\[Null]"}]]}]}], ")"}], 
         RowBox[{"sp", "[", 
          RowBox[{"p1", ",", 
           RowBox[{"k1", "-", "k2"}]}], "]"}]}], ",", 
        RowBox[{
         OverscriptBox["Km", "^"], 
         SubscriptBox[
          RowBox[{"(", 
           SubscriptBox["g", 
            RowBox[{"\[Mu]", ",", "\[Nu]"}]], ")"}], 
          RowBox[{"\[Null]", "\[Perpendicular]", "\[Null]"}]], 
         RowBox[{"sp", "[", 
          RowBox[{"p1", ",", 
           RowBox[{"k1", "-", "k2"}]}], "]"}]}], ",", 
        RowBox[{
         OverscriptBox["Km", "^"], 
         SubscriptBox[
          RowBox[{"(", 
           SubscriptBox["k2", "\[Nu]"], ")"}], 
          RowBox[{"\[Null]", "\[Perpendicular]", "\[Null]"}]], 
         SubscriptBox[
