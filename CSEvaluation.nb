Cell[BoxData[{
 RowBox[{
  RowBox[{"ncalc", "=", 
   RowBox[{"Evaluate", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          FractionBox["delta1exact", "anum"], ",", 
          RowBox[{"Normal", "@", "delta2ser"}], ",", 
          RowBox[{
           RowBox[{"Coefficient", "[", 
            RowBox[{
             RowBox[{"Normal", "@", "delta2ser"}], ",", "nf"}], "]"}], "/.", 
           RowBox[{"Lbl", "\[Rule]", "0"}]}], ",", 
          RowBox[{"Coefficient", "[", 
           RowBox[{
            RowBox[{"Normal", "@", "delta2ser"}], ",", "Lbl"}], "]"}], ",", 
          RowBox[{
           RowBox[{"Normal", "@", 
            RowBox[{"Normal", "@", "delta2ser"}]}], "/.", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"nf", "\[Rule]", "0"}], ",", 
             RowBox[{"Lbl", "\[Rule]", "0"}]}], "}"}]}]}], "}"}], "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"nf", "\[Rule]", "1"}], ",", 
          RowBox[{"Lbl", "\[Rule]", "1"}]}], "}"}]}], "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"log2\[Omega]0", "\[Rule]", 
          RowBox[{"Log", "[", 
           FractionBox["1", "10"], "]"}]}], ",", 
         RowBox[{"lmm", "\[Rule]", 
          RowBox[{"Log", "[", 
           FractionBox["1", 
            SuperscriptBox["x", "2"]], "]"}]}]}], "}"}]}], "/.", 
      RowBox[{"m", "\[Rule]", 
       FractionBox["1", "x"]}]}], "/.", 
     RowBox[{"T", "\[Rule]", 
      FractionBox["2", "3"]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pl6", "=", 
   RowBox[{"Plot", "[", 
    RowBox[{"ncalc", ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "10", ",", 
       SuperscriptBox["10", "5"]}], "}"}], ",", 
     RowBox[{"PlotRange", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"10", ",", 
          SuperscriptBox["10", "5"]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "2"}], " ", 
           SuperscriptBox["10", "4"]}], ",", 
          SuperscriptBox["10", "5"]}], "}"}]}], "}"}]}], ",", 
     RowBox[{"ScalingFunctions", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"\"\<Log\>\"", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Sign", "[", "#", "]"}], " ", 
            RowBox[{"Log", "[", 
             RowBox[{"1", "+", 
              RowBox[{"Abs", "[", "#", "]"}]}], "]"}]}], "&"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"Sign", "[", "#", "]"}], "*", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Exp", "[", 
               RowBox[{"Abs", "[", "#", "]"}], "]"}], "-", "1"}], ")"}]}], 
           "&"}]}], "}"}]}], "}"}]}], ",", 
     RowBox[{"PlotStyle", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"Red", ",", 
          RowBox[{"Dashing", "[", "0.01", "]"}], ",", 
          RowBox[{"Thickness", "[", "0.004", "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"Black", ",", 
          RowBox[{"Dashing", "[", "0.02", "]"}], ",", 
          RowBox[{"Thickness", "[", "0.004", "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Darker", "[", "Green", "]"}], ",", 
          RowBox[{"Thickness", "[", "0.002", "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Darker", "[", "Blue", "]"}], ",", 
          RowBox[{"Thickness", "[", "0.002", "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Darker", "[", "Orange", "]"}], ",", 
          RowBox[{"Thickness", "[", "0.002", "]"}]}], "}"}]}], "}"}]}], ",", 
     RowBox[{"AxesLabel", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{"\"\<\!\(\*FractionBox[SqrtBox[\(s\)], SubscriptBox[\(m\), \
\(e\)]]\)\>\"", ",", "Medium", ",", "Bold"}], "]"}], ",", 
        RowBox[{"Style", "[", 
         RowBox[{"\"\<\!\(\*SubscriptBox[\(\[Delta]\), \
\(2\)]\)/\!\(\*SuperscriptBox[\(a\), \(2\)]\), \
\!\(\*SubscriptBox[\(\[Delta]\), \(1\)]\)/a\>\"", ",", "Large", ",", 
          "Medium"}], "]"}]}], "}"}]}], ",", 
     RowBox[{"PlotLegends", "\[Rule]", 
      RowBox[{"Placed", "[", 
       RowBox[{
        RowBox[{"LineLegend", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Style", "[", 
            RowBox[{"\"\<\!\(\*SubscriptBox[\(\[Delta]\), \(1\)]\)/a\>\"", ",", 
             RowBox[{"FontFamily", "\[Rule]", "\"\<Times\>\""}]}], "]"}], ",", 
           RowBox[{"Style", "[", 
            
            RowBox[{"\"\<\!\(\*SubscriptBox[\(\[Delta]\), \
\(2\)]\)/\!\(\*SuperscriptBox[\(a\), \(2\)]\)\>\"", ",", 
             RowBox[{"FontFamily", "\[Rule]", "\"\<Times\>\""}]}], "]"}], ",", 
           RowBox[{"Style", "[", 
            
            RowBox[{"\"\<\!\(\*SubscriptBox[\(\[Delta]\), \
\(VP\)]\)/\!\(\*SuperscriptBox[\(a\), \(2\)]\)\>\"", ",", 
             RowBox[{"FontFamily", "\[Rule]", "\"\<Times\>\""}]}], "]"}], ",", 
           RowBox[{"Style", "[", 
            
            RowBox[{"\"\<\!\(\*SubscriptBox[\(\[Delta]\), \
\(LBL\)]\)/\!\(\*SuperscriptBox[\(a\), \(2\)]\)\>\"", ",", 
             RowBox[{"FontFamily", "\[Rule]", "\"\<Times\>\""}]}], "]"}], ",", 
           RowBox[{"Style", "[", 
            
            RowBox[{"\"\<\!\(\*SubscriptBox[\(\[Delta]\), \
\(PH\)]\)/\!\(\*SuperscriptBox[\(a\), \(2\)]\)\>\"", ",", 
             RowBox[{"FontFamily", "\[Rule]", "\"\<Times\>\""}]}], "]"}]}], 
          "}"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"0.90", ",", "0.75"}], "}"}]}], "]"}]}], ",", 
     RowBox[{"Ticks", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"Automatic", ",", 
        RowBox[{"Join", "@@", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Abs", "[", "q", "]"}], "\[GreaterEqual]", "3"}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"w", " ", 
                SuperscriptBox["10", "q"]}], ",", 
               RowBox[{"\"\<\\!\\(\\*SuperscriptBox[\\(\>\"", "<>", 
                RowBox[{"ToString", "[", 
