                RowBox[{"ToString", "[", "q", "]"}], 
                "<>", "\"\<\\)]\\)\>\""}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"w", " ", 
                SuperscriptBox["10", "q"]}], ",", 
               RowBox[{"ToString", "[", 
                RowBox[{"w", " ", 
                 SuperscriptBox["10", "q"]}], "]"}]}], "}"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"q", ",", "1", ",", "5"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"w", ",", 
             RowBox[{"{", 
              RowBox[{"1", ",", 
               RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], "]"}]}]}], "}"}]}]}], 
