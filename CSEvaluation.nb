Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"Executing\\n\"\>", "\[InvisibleSpace]", 
   TagBox[
    RowBox[{
     RowBox[{
      RowBox[{"k1", "\[CenterDot]", "k1"}], "=", "0"}], ";", 
     RowBox[{
      RowBox[{"k1", "\[CenterDot]", "k2"}], "=", 
      FractionBox["1", "2"]}], ";", 
     RowBox[{
      RowBox[{"k1", "\[CenterDot]", "p1"}], "=", 
      FractionBox["T", "2"]}], ";", 
     RowBox[{
      RowBox[{"k1", "\[CenterDot]", "p2"}], "=", 
      FractionBox[
       RowBox[{"1", "-", "T"}], "2"]}], ";", 
     RowBox[{
      RowBox[{"k2", "\[CenterDot]", "k2"}], "=", "0"}], ";", 
     RowBox[{
      RowBox[{"k2", "\[CenterDot]", "p1"}], "=", 
      FractionBox[
       RowBox[{"1", "-", "T"}], "2"]}], ";", 
     RowBox[{
      RowBox[{"k2", "\[CenterDot]", "p2"}], "=", 
      FractionBox["T", "2"]}], ";", 
     RowBox[{
      RowBox[{"p1", "\[CenterDot]", "p1"}], "=", 
      SuperscriptBox["m", "2"]}], ";", 
     RowBox[{
      RowBox[{"p1", "\[CenterDot]", "p2"}], "=", 
      RowBox[{
       FractionBox["1", "2"], "-", 
       SuperscriptBox["m", "2"]}]}], ";", 
     RowBox[{
      RowBox[{"p2", "\[CenterDot]", "p2"}], "=", 
      SuperscriptBox["m", "2"]}], ";"}],
    HoldForm]}],
  SequenceForm["Executing\n", 
   HoldForm[
   Vectors`sp[$CellContext`k1, $CellContext`k1] = 0; 
    Vectors`sp[$CellContext`k1, $CellContext`k2] = Rational[1, 2]; 
    Vectors`sp[$CellContext`k1, $CellContext`p1] = 
     Rational[1, 2] $CellContext`T; 
    Vectors`sp[$CellContext`k1, $CellContext`p2] = 
     Rational[1, 2] (1 - $CellContext`T); 
    Vectors`sp[$CellContext`k2, $CellContext`k2] = 0; 
    Vectors`sp[$CellContext`k2, $CellContext`p1] = 
     Rational[1, 2] (1 - $CellContext`T); 
    Vectors`sp[$CellContext`k2, $CellContext`p2] = 
     Rational[1, 2] $CellContext`T; 
    Vectors`sp[$CellContext`p1, $CellContext`p1] = $CellContext`m^2; 
    Vectors`sp[$CellContext`p1, $CellContext`p2] = 
     Rational[1, 2] - $CellContext`m^2; 
    Vectors`sp[$CellContext`p2, $CellContext`p2] = $CellContext`m^2; Null]],
  Editable->False]], "Print",
 CellChangeTimes->{4.002956259780485*^9, 4.002956488387271*^9, 
