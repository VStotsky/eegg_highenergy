  4.002956535744321*^9}},ExpressionUUID->"88b60dac-8387-4b13-a643-\
be9ec631a78b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"<<", "LiteRed2`"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"<<", "RNL`GMatrices`"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"<<", "REPLica`"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SetDim", "[", "d", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Declare", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"l1", ",", "l2", ",", "p1", ",", "p2", ",", "k1", ",", "k2"}], 
     "}"}], ",", "Vector", ",", 
    RowBox[{"{", 
     RowBox[{
     "mm", ",", "t", ",", "m", ",", "u", ",", "lmm", ",", "T", ",", "U", ",", 
      "log2\[Omega]0"}], "}"}], ",", "Number", ",", 
    RowBox[{"{", 
     RowBox[{
     "\[Alpha]", ",", "\[Beta]", ",", "\[Mu]", ",", "\[Nu]", ",", "\[Sigma]", 
      ",", "\[Lambda]"}], "}"}], ",", "VectorIndex"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"k2rule", "=", 
   RowBox[{"k2", ":>", 
    RowBox[{"p1", "+", "p2", "-", "k1"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SetConstraints", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"p1", ",", "p2", ",", "k1", ",", "k2"}], "}"}], ",", "\n", 
    RowBox[{
     RowBox[{
      RowBox[{"sp", "[", "p1", "]"}], "=", 
      RowBox[{
       RowBox[{"sp", "[", "p2", "]"}], "=", 
       SuperscriptBox["m", "2"]}]}], ";", 
     RowBox[{
      RowBox[{"sp", "[", "k1", "]"}], "=", 
      RowBox[{
       RowBox[{"sp", "[", 
        RowBox[{"p1", "+", "p2", "-", "k1"}], "]"}], "=", "0"}]}], ";", 
     RowBox[{
      RowBox[{"sp", "[", 
       RowBox[{"p1", "+", "p2"}], "]"}], "=", "1"}], ";", 
     RowBox[{
      RowBox[{"sp", "[", 
       RowBox[{"p1", "-", "k1"}], "]"}], "=", 
      RowBox[{
       SuperscriptBox["m", "2"], "-", "T"}]}], ";", 
     RowBox[{
      RowBox[{"sp", "[", 
       RowBox[{"k2", ",", "k2"}], "]"}], "=", "0"}], ";", 
     RowBox[{
      RowBox[{"sp", "[", 
       RowBox[{"k1", ",", "k2"}], "]"}], "=", 
      FractionBox["1", "2"]}], ";", 
     RowBox[{
      RowBox[{"sp", "[", 
       RowBox[{"k2", ",", "p2"}], "]"}], "=", 
      FractionBox["T", "2"]}], ";", 
     RowBox[{
      RowBox[{"sp", "[", 
       RowBox[{"k2", ",", "p1"}], "]"}], "=", 
      FractionBox[
       RowBox[{"1", "-", "T"}], "2"]}], ";"}]}], "\n", "]"}], ";"}]}], "Input",\

