\\(e\\)], \\(2\\)] - t\\), \\(s\\)]\\), \
m=\\!\\(\\*FractionBox[SubscriptBox[\\(m\\), \\(e\\)], SqrtBox[\\(s\\)]]\\), \
lmm=Log[\\!\\(\\*SuperscriptBox[\\(m\\), \\(2\\)]\\)], ipi=I*\[Pi].\"\>"], \
